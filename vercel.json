{
  "framework": null,
  "buildCommand": "node build.mjs",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "Content-Security-Policy", "value": "default-src 'self'; connect-src https://*.supabase.co; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"},
        {"key": "Referrer-Policy", "value": "no-referrer"},
        {"key": "X-Content-Type-Options", "value": "nosniff"}
      ]
    }
  ]
}
